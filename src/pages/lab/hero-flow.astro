---
// 首屏流程圖組裝預覽（只在 localhost 看，正式網站不出現）
// 網址：http://localhost:4330/portfolio/lab/hero-flow/
// 模擬放進首屏的樣子：大標 → 流程圖 → 副標
import Layout from "../../layouts/Layout.astro";
import HeroFlow from "../../components/hero-flow/HeroFlow.astro";
import { hero } from "../../content/interior";

if (import.meta.env.PROD) return Astro.redirect(import.meta.env.BASE_URL);
---

<Layout title="Hero 流程圖預覽">
	<section class="hf-stage px-6 pb-20 pt-16">
		<div class="mx-auto max-w-6xl">
			<h1 class="mx-auto max-w-3xl text-center font-serif text-[2rem] font-bold leading-tight text-ink sm:text-[2.5rem]">
				{hero.title}
			</h1>
			<div class="mt-10">
				<HeroFlow editable />
			</div>
			<h2 class="mx-auto mt-10 max-w-3xl text-center text-2xl font-bold leading-snug text-ink/80 sm:text-3xl">{hero.lead}</h2>
		</div>
	</section>
</Layout>
