---
// 首屏流程圖的卡片樣品頁（只在 localhost 看，正式網站不出現）
// 網址：http://localhost:4330/portfolio/lab/hero-cards/
// 樣式定好後，卡片會搬進 Hero 組成整張流程圖，這頁就可以刪掉
import Layout from "../../layouts/Layout.astro";
import "../../styles/hero-flow.css";
import { asset } from "../../lib/asset";

if (import.meta.env.PROD) return Astro.redirect(import.meta.env.BASE_URL);

// 線條圖示（stroke 跟著文字顏色）
const icons = {
	doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h4"/>',
	// AI 小機器人：頭、天線、兩隻眼睛、耳朵
	bot: '<rect x="4" y="8" width="16" height="12" rx="4"/><path d="M12 8V5.5"/><circle cx="12" cy="4.2" r="1.3"/><circle cx="9.2" cy="14" r="1.2" fill="currentColor" stroke="none"/><circle cx="14.8" cy="14" r="1.2" fill="currentColor" stroke="none"/><path d="M2 12.5v3M22 12.5v3"/>',
	check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
	chat: '<path d="M4 5.5h16v10.5H10l-6 4z"/><path d="M8.5 10.5h7"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	bell: '<path d="M6 16V11a6 6 0 1112 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 004 0"/>',
	grid: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
	user: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1-3.5 3.8-5.5 7-5.5s6 2 7 5.5"/>',
	loop: '<path d="M20 12a8 8 0 11-2.3-5.7"/><path d="M20 4v4.5h-4.5"/>',
	camera: '<rect x="3" y="7" width="18" height="13" rx="3"/><circle cx="12" cy="13.5" r="3.5"/><path d="M8.5 7l1.5-3h4l1.5 3"/>',
};
// AI 工具的 logo（Claude、Codex），來源 @lobehub/icons-static-svg 1.106.0
const claude = asset("/hero-flow/claude.svg");
const codex = asset("/hero-flow/codex.svg");

const svg = (name: keyof typeof icons, size = 18) =>
	`<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<Layout title="Hero 卡片樣品">
	<main class="mx-auto max-w-6xl px-6 py-16">
		<p class="hf-eyebrow">Lab · Hero Flow</p>
		<h1 class="mt-2 text-3xl font-bold">首屏流程圖：卡片樣式樣品 v2</h1>
		<p class="mt-3 max-w-2xl text-ink/70">
			v2：原本的簽約開案併進儀表板、圓角加大、深色卡改深黑、業主專案頁只留玻璃版、文字精簡、AI 處換成 Claude ＆ Codex 圖示。
		</p>

		<section class="hf-stage mt-10 rounded-[28px] border border-ink/10 px-6 py-14 sm:px-12">
			<div class="relative grid gap-12 lg:grid-cols-2">
				<!-- STEP 01 諮詢紀錄 -->
				<div>
					<p class="mb-3 text-sm font-medium text-ink/60">STEP 01・諮詢紀錄</p>
					<article class="hf-card p-6">
						<header class="flex items-center justify-between gap-3">
							<span class="hf-eyebrow">Step 01 ／ 諮詢</span>
							<span class="hf-tag hf-tag--ai"><img src={claude} alt="" width="13" height="13" />AI 摘要</span>
						</header>
						<div class="mt-4 flex items-center gap-3">
							<span class="hf-icon" set:html={svg("doc")} />
							<div>
								<h3 class="text-lg font-bold leading-snug">業主 A・新諮詢</h3>
								<p class="text-xs text-muted">官網表單＋線上會議</p>
							</div>
						</div>
						<ul class="mt-4 space-y-1.5 text-[15px] text-ink/85">
							<li class="flex gap-2"><span class="text-brand">•</span>資料散在 LINE 和檔案裡</li>
							<li class="flex gap-2"><span class="text-brand">•</span>常被問進度</li>
							<li class="flex gap-2"><span class="text-brand">•</span>帳目對不上</li>
						</ul>
						<div class="mt-4 flex flex-wrap gap-2">
							<span class="hf-tag hf-tag--neutral">需求 3 項</span>
							<span class="hf-tag hf-tag--neutral">下一步：提案</span>
						</div>
					</article>
				</div>

				<!-- STEP 02 AI 整理 -->
				<div>
					<p class="mb-3 text-sm font-medium text-ink/60">STEP 02・AI 整理需求（深黑）</p>
					<article class="hf-card hf-card--dark p-6">
						<header class="flex items-center justify-between gap-3">
							<span class="hf-eyebrow">Step 02 ／ AI 處理中</span>
							<span class="flex gap-1" aria-hidden="true">
								<i class="h-1.5 w-1.5 rounded-full bg-white/25"></i>
								<i class="h-1.5 w-1.5 rounded-full bg-white/45"></i>
								<i class="h-1.5 w-1.5 rounded-full bg-[#f27bb8]"></i>
							</span>
						</header>
						<div class="mt-4 flex items-center gap-3">
							<span class="hf-agents" aria-label="Claude 與 Codex">
								<span class="hf-agent"><img src={claude} alt="" /></span>
								<span class="hf-agent"><img src={codex} alt="" /></span>
							</span>
							<h3 class="text-xl font-bold leading-snug">AI 整理需求</h3>
						</div>
						<ul class="mt-4 space-y-2.5 text-[15px] text-white/85">
							<li class="flex items-center gap-2.5"><span class="text-[#f27bb8]" set:html={svg("check", 16)} />讀取會議紀錄</li>
							<li class="flex items-center gap-2.5"><span class="text-[#f27bb8]" set:html={svg("check", 16)} />整理需求重點</li>
							<li class="flex items-center gap-2.5 text-white/60"><span set:html={svg("loop", 16)} />建立 Notion 專案</li>
						</ul>
						<div class="mt-5 flex items-center gap-3">
							<div class="hf-bar flex-1"><span style="width:72%"></span></div>
							<span class="hf-eyebrow" style="font-size:10px">Running</span>
						</div>
					</article>
				</div>

				<!-- STEP 03 通知：玻璃膠囊 -->
				<div class="lg:col-span-2">
					<p class="mb-3 text-sm font-medium text-ink/60">STEP 03・同步通知兩邊（液態玻璃）</p>
					<div class="relative flex flex-wrap items-center gap-4 pt-2">
						<div class="hf-glow hf-glow--pink" style="width:240px;height:240px;left:-20px;top:-70px"></div>
						<div class="hf-glow hf-glow--sky" style="width:220px;height:220px;left:220px;top:-40px"></div>
						<div class="hf-glass hf-glass--pill flex items-center gap-3 py-2.5 pl-2.5 pr-5">
							<span class="hf-icon !h-8 !w-8 !rounded-full !bg-white/70" set:html={svg("bell", 16)} />
							<div class="leading-tight">
								<p class="hf-eyebrow" style="font-size:10px">團隊・now</p>
								<p class="text-sm font-medium">已分派 5 項任務</p>
							</div>
						</div>
						<div class="hf-glass hf-glass--pill flex items-center gap-3 py-2.5 pl-2.5 pr-5">
							<span class="hf-icon !h-8 !w-8 !rounded-full !bg-white/70" set:html={svg("user", 16)} />
							<div class="leading-tight">
								<p class="hf-eyebrow" style="font-size:10px">業主 A・now</p>
								<p class="text-sm font-medium">專案頁已開通</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- STEP 04 儀表板 ＋ 業主專案頁 -->
			<div class="relative mt-14">
				<p class="mb-3 text-sm font-medium text-ink/60">STEP 04・內部專案儀表板（含 AI 週報、兩顆按鈕）＋ 業主 A 的專案頁（玻璃）</p>
				<div class="grid items-start gap-8 lg:grid-cols-[1.3fr_1fr]">
					<article class="hf-card p-6">
						<header class="flex items-center justify-between gap-3">
							<div class="flex items-center gap-3">
								<span class="hf-icon" set:html={svg("grid")} />
								<div>
									<span class="hf-eyebrow">Notion ／ 內部</span>
									<h3 class="text-lg font-bold leading-snug">專案儀表板</h3>
								</div>
							</div>
							<span class="hf-tag hf-tag--notion">Notion</span>
						</header>

						<div class="hf-rows mt-5">
							<div>
								<span class="w-16 shrink-0 font-medium">業主 A</span>
								<div class="hf-bar flex-1"><span style="width:12%"></span></div>
								<span class="hf-tag hf-tag--wait">開案中</span>
							</div>
							<div>
								<span class="w-16 shrink-0 font-medium">業主 B</span>
								<div class="hf-bar flex-1"><span style="width:68%"></span></div>
								<span class="hf-tag hf-tag--neutral">68%</span>
							</div>
							<div>
								<span class="w-16 shrink-0 font-medium">業主 C</span>
								<div class="hf-bar flex-1"><span style="width:100%"></span></div>
								<span class="hf-tag hf-tag--done">已結案 ★ 5.0</span>
							</div>
						</div>

						<!-- AI 週報示意 -->
						<div class="mt-4 flex gap-3 rounded-2xl bg-pink-50 p-4">
							<span class="hf-agents hf-agents--sm" aria-label="Claude 與 Codex">
								<span class="hf-agent"><img src={claude} alt="" /></span>
								<span class="hf-agent"><img src={codex} alt="" /></span>
							</span>
							<div class="text-sm leading-relaxed">
								<p class="font-medium text-brand">AI 週報</p>
								<p class="mt-0.5 text-ink/80">業主 B 本週完成 2 項，1 項待確認</p>
							</div>
						</div>

						<div class="mt-5 flex flex-wrap gap-2">
							<span class="hf-btn hf-btn--primary" set:html={svg("chat", 15) + "更新專案進度"} />
							<span class="hf-btn hf-btn--ghost" set:html={svg("plus", 15) + "新增案場進度"} />
						</div>
					</article>

					<!-- 業主 A 的專案頁：玻璃 -->
					<div class="relative">
						<div class="hf-glow hf-glow--pink" style="width:300px;height:300px;left:-40px;top:-30px"></div>
						<div class="hf-glow hf-glow--sky" style="width:260px;height:260px;right:-40px;bottom:-40px"></div>
						<article class="hf-glass p-5">
							<header class="flex items-center justify-between">
								<span class="hf-eyebrow">業主 A 的專案頁</span>
								<span class="hf-tag hf-tag--ai">待確認 1</span>
							</header>
							<ol class="hf-timeline mt-4">
								<li class="is-done">簽約</li>
								<li class="is-now">施工中</li>
								<li>驗收</li>
							</ol>
							<ul class="mt-5 space-y-2">
								<li class="flex items-center gap-3 rounded-2xl bg-white/55 px-3 py-2.5">
									<span class="hf-icon !h-8 !w-8 !bg-white/80" set:html={svg("camera", 15)} />
									<div class="min-w-0 flex-1 leading-tight">
										<p class="text-sm font-medium">木作完成，已上傳照片</p>
										<p class="text-xs text-muted">11/28</p>
									</div>
								</li>
								<li class="flex items-center gap-3 rounded-2xl bg-white/55 px-3 py-2.5">
									<span class="hf-icon !h-8 !w-8 !bg-white/80" set:html={svg("check", 15)} />
									<div class="min-w-0 flex-1 leading-tight">
										<p class="text-sm font-medium">水電完工，請確認</p>
										<p class="text-xs text-muted">12/02</p>
									</div>
									<span class="hf-btn hf-btn--primary !px-3 !py-1 !text-xs">確認</span>
								</li>
							</ul>
						</article>
					</div>
				</div>
			</div>

			<!-- 連接線 -->
			<div class="relative mt-14">
				<p class="mb-3 text-sm font-medium text-ink/60">連接線（虛線＋圓點起點＋三角箭頭）</p>
				<svg viewBox="0 0 600 120" class="h-28 w-full max-w-xl" aria-hidden="true">
					<circle class="hf-node" cx="12" cy="20" r="5" />
					<path class="hf-line" d="M12 20 C 200 20, 260 100, 580 100" />
					<path class="hf-node" d="M580 100 l-10 -5 v10 z" />
				</svg>
			</div>
		</section>
	</main>
</Layout>
