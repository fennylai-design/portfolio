---
// 區段外框：統一上下留白、內容寬度、底色交替（base ↔ surface）
interface Props {
	id?: string;
	tone?: "base" | "surface";
	class?: string;
}
const { id, tone = "base", class: extra = "" } = Astro.props;
---

<section
	id={id}
	class={`snap-start py-20 sm:py-28 ${tone === "surface" ? "bg-surface" : "bg-base"} ${extra}`}
>
	<div class="mx-auto max-w-5xl px-6">
		<slot />
	</div>
</section>
