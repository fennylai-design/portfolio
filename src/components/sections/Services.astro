---
// 服務方案（11/25 改版，參考 Fenny 給的兩張深色官網卡片）
// 卡片：半透明深色玻璃＋圓角；由上而下：標題 → 你會得到（一句）→ 做什麼（小方塊清單）→ 底部滿版插圖（11/25 拿掉 STEP 編號）
// 背景是淡出的白色網格；深藍底上的點綴色用淺藍 hl-sky
import Section from "../ui/Section.astro";
import Placeholder from "../ui/Placeholder.astro";
import ServiceArt from "./ServiceArt.astro";
import { services } from "../../content/interior";
import { asset } from "../../lib/asset";
---

<Section id="services" tone="night-2" class="relative overflow-hidden">
	<!-- 網格背景（11/25 取代兩側彎線）：白色細線 48px 一格，往四周淡出 -->
	<div class="svc-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
	<!-- 標題置中：大標＋下面一行淺藍副標（11/25） -->
	<div class="relative text-center">
		<h2 class="text-4xl font-bold leading-tight tracking-tight sm:text-6xl sm:leading-tight">{services.title}</h2>
		<p class="mt-5 text-xl font-bold text-hl-sky sm:text-2xl">{services.intro}</p>
	</div>
	<div class="relative mt-12">
		<div class="relative grid gap-5 md:grid-cols-3">
			{services.items.map((s) => (
				<article class="svc-card flex h-full flex-col rounded-[26px] p-7">
					<h3 class="text-3xl font-bold leading-tight tracking-tight">{s.sub}</h3>
					<p class="mt-3 text-lg leading-relaxed text-ink/85">{s.gets}</p>
					<ul class="mb-8 mt-6 space-y-3">
						{s.does.map((d) => (
							<li class="flex items-baseline gap-3 text-base text-ink/90">
								<span class="h-1.5 w-1.5 shrink-0 translate-y-[-2px] bg-hl-sky" aria-hidden="true"></span>{d}
							</li>
						))}
					</ul>
					<!-- 插圖：卡片底部滿版，上面隔一條線；11/27 起用 ServiceArt 畫的線條流程圖（content 填 art）；也可放圖片（填 image）；都沒有顯示待補框 -->
					<div class="-mx-7 -mb-7 mt-auto aspect-[4/3] overflow-hidden rounded-b-[26px] border-t border-white/10">
						{s.art
							? <ServiceArt kind={s.art} />
							: s.image
							? <img src={asset(s.image)} alt="" class="h-full w-full object-cover" loading="lazy" />
							: <Placeholder label={`插圖：${s.sub}`} class="h-full w-full border-0" />}
					</div>
				</article>
			))}
		</div>
	</div>
</Section>

<style>
	.svc-grid {
		background-image:
			linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
		background-size: 48px 48px;
		background-position: center top;
		-webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 45%, #000 40%, transparent 100%);
		mask-image: radial-gradient(ellipse 75% 70% at 50% 45%, #000 40%, transparent 100%);
	}
	/* 深色半透明玻璃卡 */
	.svc-card {
		background: linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
		-webkit-backdrop-filter: blur(18px) saturate(140%);
		backdrop-filter: blur(18px) saturate(140%);
		border: 1px solid rgb(255 255 255 / 0.12);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.12),
			0 20px 40px -20px rgb(0 0 0 / 0.5);
	}

</style>

