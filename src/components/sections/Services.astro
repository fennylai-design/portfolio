---
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import { services } from "../../content/interior";
---

<Section id="services" tone="night-2">
	<h2 class="text-3xl font-bold leading-tight">{services.title}</h2>
	<p class="mt-4 text-lg text-ink/80">{services.intro}</p>
	<div class="mt-10 grid gap-6 md:grid-cols-3">
		{services.items.map((s, i) => (
			<Card variant="outline" class="flex h-full flex-col bg-base">
				<!-- 圖示區塊：v1 佔位，v3 換成圖示 -->
				<div class="mb-6 flex h-14 w-14 items-center justify-center border border-dashed border-ink/20 text-xs text-muted" aria-hidden="true">圖示</div>
				<h3 class="text-xl font-bold leading-snug text-brand">0{i + 1}・{s.sub}</h3>
				<ul class="mb-8 mt-4 space-y-2">
					{s.does.map((d) => (
						<li class="flex gap-3 text-lg text-ink/80">
							<span class="text-brand" aria-hidden="true">・</span>{d}
						</li>
					))}
				</ul>
				<div class="mt-auto border-t border-ink/10 pt-4">
					<p class="text-lg">{s.gets}</p>
				</div>
			</Card>
		))}
	</div>
</Section>
