---
// 手機版底部常駐預約按鈕：首屏按鈕或聯絡區按鈕在畫面上時隱藏，避免同畫面兩顆 primary
import Button from "../ui/Button.astro";
import { bookingUrl } from "../../content/interior";
---

<div
	id="mobile-cta"
	class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-ink/10 bg-base/95 p-4 backdrop-blur transition-transform duration-200 md:hidden"
>
	<Button href={bookingUrl} class="w-full">預約 60 分鐘訪談</Button>
</div>

<script>
	const bar = document.getElementById("mobile-cta");
	const targets = document.querySelectorAll(".js-hero-cta, .js-contact-cta");
	const visible = new Set<Element>();
	const io = new IntersectionObserver((entries) => {
		entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
		bar?.classList.toggle("translate-y-full", visible.size > 0);
	});
	targets.forEach((t) => io.observe(t));
</script>
