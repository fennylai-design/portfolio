---
// 成功案例：卡片點開跳出視窗（原生 <dialog>）看細節；Esc、點背景、點關閉都能關
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";
import Placeholder from "../ui/Placeholder.astro";
import { cases } from "../../content/interior";
---

<Section id="cases" tone="surface">
	<h2 class="text-3xl font-bold leading-tight">{cases.title}</h2>
	<div class="mt-12 grid gap-6 md:grid-cols-2">
		{cases.items.map((c, i) => (
			<button
				type="button"
				data-case-open={`case-${i}`}
				aria-haspopup="dialog"
				class={`group border border-ink/10 bg-base p-8 text-left transition-colors hover:border-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 ${c.featured ? "md:col-span-2" : ""}`}
			>
				<Placeholder label="案例畫面" class={`mb-6 ${c.featured ? "h-48 sm:h-64" : "h-48"}`} />
				<Tag color="ink">{c.industry}</Tag>
				<h3 class="mt-4 text-xl font-bold leading-snug">{c.title}</h3>
				<p class="mt-2 text-lg text-ink/80">{c.result}</p>
				<span class="mt-4 inline-block text-sm font-bold text-brand group-hover:underline underline-offset-4">看細節 →</span>
			</button>
		))}
	</div>

	{cases.items.map((c, i) => (
		<dialog
			id={`case-${i}`}
			aria-labelledby={`case-${i}-title`}
			class="m-auto w-[calc(100%-2rem)] max-w-2xl bg-base p-0 text-ink backdrop:bg-ink/60"
		>
			<div class="max-h-[85svh] overflow-y-auto p-8">
				<div class="flex items-start justify-between gap-4">
					<Tag color="ink">{c.industry}</Tag>
					<button
						type="button"
						data-case-close
						aria-label="關閉"
						class="-mr-2 -mt-2 h-10 w-10 text-2xl leading-none text-muted transition-colors hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
					>×</button>
				</div>
				<h3 id={`case-${i}-title`} class="mt-4 text-xl font-bold leading-snug">{c.title}</h3>
				<Placeholder label="案例畫面" class="mt-6 h-56" />
				<dl class="mt-8 grid gap-6">
					{[
						["遇到的困難", c.problem],
						["我的做法", c.solution],
						["成果", c.outcome],
					].map(([k, v]) => (
						<div>
							<dt class="text-sm font-semibold text-muted">{k}</dt>
							<dd class="mt-1 text-lg text-ink/80">{v}</dd>
						</div>
					))}
				</dl>
			</div>
		</dialog>
	))}

	{cases.testimonials.length > 0 && (
		<div class="mt-16 grid gap-6 md:grid-cols-2">
			{cases.testimonials.map((t) => (
				<figure>
					<blockquote class="quote">{t.quote}</blockquote>
					<figcaption class="mt-3 text-sm text-muted">— {t.who}</figcaption>
				</figure>
			))}
		</div>
	)}
</Section>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-case-open]").forEach((btn) => {
		const dlg = document.getElementById(btn.dataset.caseOpen!) as HTMLDialogElement | null;
		if (!dlg) return;
		btn.addEventListener("click", () => dlg.showModal());
		// 點背景（dialog 本身、不是裡面的內容）就關
		dlg.addEventListener("click", (e) => {
			if (e.target === dlg) dlg.close();
		});
		dlg.querySelector("[data-case-close]")?.addEventListener("click", () => dlg.close());
	});
</script>
