---
// 客戶對我的評價：第一則（最長）整列寬，其他兩則並排；還沒有評價時顯示待補框
import Section from "../ui/Section.astro";
import Placeholder from "../ui/Placeholder.astro";
import { testimonials } from "../../content/interior";
---

<Section id="testimonials">
	<h2 class="text-3xl font-bold leading-tight">{testimonials.title}</h2>
	<div class="mt-12 grid gap-6 md:grid-cols-2">
		{testimonials.items.length > 0
			? testimonials.items.map((t, i) => (
					<figure class={`flex h-full flex-col border border-ink/10 bg-base p-8 ${i === 0 ? "md:col-span-2" : ""}`}>
						<blockquote class="flex-1 space-y-3 border-l-[3px] border-brand pl-5 font-serif text-lg leading-relaxed text-ink">
							{t.quote.map((q) => <p>{q}</p>)}
						</blockquote>
						<figcaption class="mt-6 text-sm text-muted">— {t.who}</figcaption>
					</figure>
				))
			: Array.from({ length: testimonials.placeholders }).map((_, n) => (
					<Placeholder label={`客戶評價 ${n + 1}`} class="h-48" />
				))}
	</div>
</Section>
