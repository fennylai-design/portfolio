---
import Section from "../ui/Section.astro";
import { process } from "../../content/interior";
---

<Section id="process">
	<h2 class="text-3xl font-bold leading-tight">{process.title}</h2>
	<ol class="mt-12 grid gap-8 md:grid-cols-5 md:gap-6">
		{process.steps.map((s, i) => (
			<li class="border-t-2 border-ink pt-4">
				<span class="text-sm font-semibold text-brand">STEP {i + 1}</span>
				<h3 class="mt-2 text-xl font-bold leading-snug">{s.name}</h3>
				<p class="mt-2 text-lg text-ink/80">{s.text}</p>
			</li>
		))}
	</ol>
</Section>
