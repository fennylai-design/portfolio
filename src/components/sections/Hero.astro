---
import Button from "../ui/Button.astro";
import { hero, bookingUrl } from "../../content/interior";
---

<section id="top" class="bg-base py-20 sm:py-32">
	<div class="mx-auto max-w-5xl px-6">
		<p class="text-sm font-semibold text-brand">{hero.eyebrow}</p>
		<h1 class="mt-4 max-w-3xl text-[2rem] font-bold leading-tight sm:text-[2.5rem]">
			{hero.title}
		</h1>
		<p class="mt-8 max-w-2xl text-lg text-ink/80">{hero.statement}</p>
		<div class="mt-10 flex flex-wrap items-center gap-6">
			<Button size="lg" href={bookingUrl} class="js-hero-cta">{hero.primary}</Button>
			<Button variant="tertiary" href="#services">{hero.secondary} ↓</Button>
		</div>
	</div>
</section>
