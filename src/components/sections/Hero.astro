---
import Button from "../ui/Button.astro";
import HeroFlow from "../hero-flow/HeroFlow.astro";
import HeroFlowMobile from "../hero-flow/HeroFlowMobile.astro";
import { hero } from "../../content/interior";
import { heroGlows, type HeroGlow } from "../../content/hero-glows";

// glows：預設讀設定檔；調整頁會傳 editable 讓光暈可以拖
interface Props {
	glows?: HeroGlow[];
	editable?: boolean;
}
const { glows = heroGlows, editable = false } = Astro.props;
---

<!-- 首屏（11/25 改版）：文字置中，流程圖放在大標與副標中間
     桌機（lg 以上）：大標 → 寬幅流程圖（含動態）→ 副標 → 按鈕
     手機／平板：大標 → 副標 → 按鈕 → 直式流程圖（流程圖很長，副標放前面才不會被擠到很下面）
     流程圖的卡片、位置、動態都在 components/hero-flow/ -->
<section id="top" class="hf-stage snap-start pb-20 pt-28" data-hero-stage data-editable={editable ? "true" : undefined}>
	<!-- 背景：網格＋四角光暈（位置、大小、透明度在 content/hero-glows.ts，用 /lab/hero-glows/ 調） -->
	<div class="hf-grid" aria-hidden="true"></div>
	{glows.map((g, i) => (
		<div
			class={`hf-glow hf-glow--${g.tone}`}
			data-hero-glow={i}
			style={`width:${g.size}px;height:${g.size}px;left:${g.x}%;top:${g.y}%;opacity:${g.opacity};transform:translate(-50%,-50%)`}
			aria-hidden="true"
		></div>
	))}
	<div class="relative mx-auto flex w-full max-w-6xl flex-col px-6">
		<!-- 11/27 Fenny：大標改大字黑體（原 Noto Serif 明體 2–2.5rem）；手機維持 2rem -->
		<h1 class="mx-auto max-w-5xl text-center text-[2rem] font-bold leading-tight tracking-tight text-ink md:text-5xl md:leading-tight lg:text-6xl lg:leading-tight">
			{hero.titleLines.map((line) => <span class="block">{line}</span>)}
		</h1>

		<div class="order-3 mt-12 hidden lg:order-none lg:block">
			{hero.flowCaption && <p class="mb-6 text-center text-lg font-bold text-ink/70">{hero.flowCaption}</p>}
			<HeroFlow />
		</div>

		<div class="order-1 lg:order-none">
			<h2 class="mx-auto mt-6 max-w-3xl text-center text-2xl font-bold leading-snug text-ink sm:text-[1.75rem] lg:mt-12" data-hl-group>
				{(() => {
					let n = 0; // 第幾個螢光筆，用來錯開進場時間
					return hero.leadLines.map((line) => (
						<span class="block">
							{line.map((p) => (p.hl ? <mark class="hl-marker" style={`--hl-i:${n++}`}>{p.text}</mark> : p.text))}
						</span>
					));
				})()}
			</h2>
			<div class="mt-8 text-center">
				<Button variant="tertiary" href="#about">{hero.secondary} ↓</Button>
			</div>
		</div>

		<div class="order-2 mt-14 lg:hidden">
			{hero.flowCaption && <p class="mb-6 text-center text-base font-bold text-ink/70">{hero.flowCaption}</p>}
			<HeroFlowMobile />
		</div>
	</div>
</section>

<script>
	// 螢光筆：副標進到畫面就劃上，捲走就收回（11/26）
	const groups = document.querySelectorAll<HTMLElement>("[data-hl-group]");
	if ("IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => entries.forEach((e) => e.target.classList.toggle("is-hl-on", e.isIntersecting)),
			{ threshold: 0.6 },
		);
		groups.forEach((g) => io.observe(g));
	} else {
		groups.forEach((g) => g.classList.add("is-hl-on"));
	}
</script>
