---
// 一人公司跳窗圖 ③（11/27）：會前準備——問題清單和簡報，照框架先備好。
// 以前：開會前臨時翻資料想問題、從頭排簡報。
// 現在：客戶預約時填的資料＋AI 搜尋的客戶資訊 → AI Agent 照框架產出問題清單（錨點題／現況／期待）與會議簡報框架 → 人開會前看過、調整，錯了退回。
// 客戶名、填答內容都是假資料。樣式在 src/styles/solo-shot.css。調整用 /portfolio/lab/case-thumbs/
import "../../../styles/hero-flow.css";
import "../../../styles/solo-shot.css";
import { svg } from "../../hero-flow/icons";
import Agents from "../../hero-flow/Agents.astro";
import SoloAnim from "./SoloAnim.astro";
import { toolSvg, notionIcon, ARROW_H, ARROW_V, type SoloTool, humanIcon } from "./solo-shared";

const before = ["翻客戶填的表單", "上網查這家公司", "想今天要問什麼", "從頭排簡報"];
const inputs: { tool: SoloTool; title: string; text: string }[] = [
	{ tool: "form", title: "預約時填的資料", text: "室內設計・5 人團隊" },
	{ tool: "form", title: "想解決的事", text: "案場進度都在 LINE 群組" },
	{ tool: "web", title: "AI 搜尋客戶資訊", text: "官網、作品、社群" },
];
const questions: { tag: string; q: string }[] = [
	{ tag: "錨點題", q: "今天最想解決的一件事是什麼？" },
	{ tag: "現況", q: "現在案場進度怎麼回報給業主？" },
	{ tag: "現況", q: "LINE 群組裡最常被追問的是什麼？" },
	{ tag: "期待", q: "如果業主能自己看到進度，你最希望省下什麼？" },
];
const slides = ["會議流程", "服務介紹", "案例分享", "合作流程"];
const T = [200, 850, 1500]; // 輸入、AI 產出、人
---

<div class="so" data-so>
	<section class="so-row so-row--before">
		<p class="so-title"><span class="so-tag">以前</span>開會前臨時準備</p>
		<ul class="so-chips">{before.map((t) => <li class="so-chip">{t}</li>)}</ul>
		<p class="so-note so-note--before">準備得多深，看那天剩多少時間</p>
	</section>

	<section class="so-row so-row--after">
		<p class="so-title"><span class="so-tag so-tag--after">現在</span>照框架先備好問題清單和簡報</p>

		<div class="so-flow">
			<div data-at={T[0]}>
				<p class="so-sub">AI 先讀這些</p>
				<ul class="so-src-list">
					{inputs.map((s) => (
						<li class="so-src">
							<span class="so-ico" set:html={toolSvg[s.tool as Exclude<SoloTool, "notion">]} />
							<b>{s.title}</b>
						</li>
					))}
				</ul>
			</div>

			<span class="so-arrow so-arrow--h" data-at={T[1]} set:html={ARROW_H} />
			<span class="so-arrow so-arrow--v" data-at={T[1]} set:html={ARROW_V} />

			<div class="so-ai" data-at={T[1]}>
				<p class="so-ai-head"><Agents size="sm" />AI Agent 照框架產出</p>
				<div class="so-outs so-outs--2">
					<article class="hf-card so-out">
						<header class="so-out-head">
							<span class="flex items-center gap-1.5"><img src={notionIcon} alt="" width="14" height="14" />問題清單</span>
							<span class="hf-tag hf-tag--neutral">晨光工作室</span>
						</header>
						<ol class="pq-list">
							{questions.map((x) => (
								<li><span class={`pq-tag ${x.tag === "錨點題" ? "pq-tag--anchor" : ""}`}>{x.tag}</span><span>{x.q}</span></li>
							))}
						</ol>
					</article>
					<article class="hf-card so-out">
						<header class="so-out-head">
							<span class="flex items-center gap-1.5"><span class="inline-flex" set:html={toolSvg.slides} />會議簡報框架</span>
						</header>
						<ol class="pq-slides">
							{slides.map((t, i) => (
								<li>
									<span class="pq-slide"><span class="num pq-slide-num">{String(i + 1).padStart(2, "0")}</span><span class="pq-slide-bar"></span><span class="pq-slide-bar pq-slide-bar--short"></span></span>
									<span class="pq-slide-label">{t}</span>
								</li>
							))}
						</ol>
					</article>
				</div>
			</div>
		</div>

		<div class="so-human-wrap" data-at={T[2]}>
			<span class="so-arrow" set:html={ARROW_V} />
			<div class="hf-card so-human">
				<span class="so-avatar"><img src={humanIcon} alt="人" width="28" height="35" /></span>
				<span class="so-human-text">開會前看過、調整問題順序</span>
				<span class="so-loop ml-auto"><span class="so-plus">+1</span>錯了退回，AI 記住下次不再犯</span>
			</div>
		</div>
		<p class="so-note so-note--after" data-at={T[2]}>每場諮詢都有同樣水準的準備</p>
	</section>
	<SoloAnim />
</div>

<style>
	.pq-list {
		display: grid;
		gap: 0.375rem;
		margin-top: 0.625rem;
	}
	.pq-list > li {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		line-height: 1.5;
	}
	.pq-tag {
		flex: none;
		padding: 0 7px;
		border-radius: 999px;
		background: #faf7f3;
		box-shadow: inset 0 0 0 1px rgb(34 29 33 / 0.1);
		font-size: 11px;
		font-weight: 600;
		color: rgb(34 29 33 / 0.6);
	}
	.pq-tag--anchor {
		background: var(--color-pink-50);
		box-shadow: inset 0 0 0 1px rgb(217 53 141 / 0.2);
		color: var(--color-brand);
	}
	.pq-slides {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.375rem;
		margin-top: 0.625rem;
	}
	.pq-slides > li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}
	.pq-slide {
		display: flex;
		flex-direction: column;
		gap: 4px;
		aspect-ratio: 16 / 10;
		padding: 6px;
		border-radius: 8px;
		background: linear-gradient(135deg, #fdf0f6, #eef4ff);
		box-shadow: inset 0 0 0 1px rgb(34 29 33 / 0.08);
	}
	.pq-slide-num {
		font-size: 10px;
		font-weight: 700;
		color: var(--color-brand);
	}
	.pq-slide-bar {
		height: 4px;
		width: 80%;
		border-radius: 2px;
		background: rgb(34 29 33 / 0.18);
	}
	.pq-slide-bar--short {
		width: 50%;
		background: rgb(34 29 33 / 0.1);
	}
	.pq-slide-label {
		font-size: 11px;
		font-weight: 600;
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
