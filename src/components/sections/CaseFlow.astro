---
// 案例跳窗裡的流程圖（11/27）：一組客戶走過的階段，上排「客戶看到的」（前台）、下排「團隊內部」（後台）。
// 有串接點的階段標粉色編號，對應下方「怎麼串起來」。電腦版橫排表格，手機版改直排。先做靜態版，動態之後再決定。
import type { CaseItem } from "../../content/interior";

interface Props {
	flow: NonNullable<CaseItem["flow"]>;
	frontLabel?: string;
	backLabel?: string;
}
const { flow, frontLabel = "新人看到的", backLabel = "團隊內部" } = Astro.props;
---

<figure class="rounded-2xl bg-white p-5 sm:p-6" aria-label="流程圖">
	{/* 電腦版：橫排 */}
	<div class="hidden md:grid" style={`grid-template-columns: 4.5rem repeat(${flow.length}, minmax(0, 1fr)); row-gap: 0.75rem; column-gap: 0.5rem;`}>
		<div></div>
		{flow.map((s, i) => (
			<div class="relative flex items-center gap-1.5 pb-2 text-sm font-bold">
				{i < flow.length - 1 && <span class="absolute -right-2 left-0 bottom-0 h-px bg-line" aria-hidden="true"></span>}
				{s.joint ? <span class="joint">{s.joint}</span> : <span class="dot" aria-hidden="true"></span>}
				<span>{s.stage}</span>
			</div>
		))}

		<div class="self-center text-xs font-semibold text-brand">{frontLabel}</div>
		{flow.map((s) => (
			<div class="cell cell-front">{s.front}</div>
		))}

		<div class="self-center text-xs font-semibold text-darkblue">{backLabel}</div>
		{flow.map((s) => (
			s.back ? <div class="cell cell-back">{s.back}</div> : <div></div>
		))}
	</div>

	{/* 手機版：直排 */}
	<ol class="space-y-4 md:hidden">
		{flow.map((s) => (
			<li class="flex gap-3">
				{s.joint ? <span class="joint mt-0.5">{s.joint}</span> : <span class="dot mt-2" aria-hidden="true"></span>}
				<div class="min-w-0">
					<p class="text-sm font-bold">{s.stage}</p>
					<p class="mt-1 text-sm text-ink/80"><span class="font-semibold text-brand">{frontLabel}｜</span>{s.front}</p>
					{s.back && <p class="mt-0.5 text-sm text-ink/80"><span class="font-semibold text-darkblue">{backLabel}｜</span>{s.back}</p>}
				</div>
			</li>
		))}
	</ol>
</figure>

<style>
	.joint {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 9999px;
		background: var(--color-brand);
		color: #fff;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1;
	}
	.dot {
		flex: none;
		width: 0.5rem;
		height: 0.5rem;
		margin-inline: 0.375rem;
		border-radius: 9999px;
		background: var(--color-muted);
	}
	.cell {
		border-radius: 0.75rem;
		padding: 0.5rem 0.625rem;
		font-size: 0.8125rem;
		line-height: 1.45;
	}
	.cell-front {
		background: var(--color-pink-50);
		color: var(--color-ink);
	}
	.cell-back {
		background: #eef4fb;
		color: var(--color-ink);
	}
</style>
