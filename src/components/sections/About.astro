---
import Section from "../ui/Section.astro";
import Placeholder from "../ui/Placeholder.astro";
import { about, benefit } from "../../content/interior";
import "../../styles/hero-flow.css";
---

<Section id="about" tone="surface">
	<div class="grid gap-12 md:grid-cols-[240px_1fr]">
		<Placeholder label={about.photoPlaceholder} class="aspect-square w-48 md:w-full" />
		<div>
			<h2 class="text-3xl font-bold leading-tight">{about.greeting}</h2>
			<div class="mt-8 max-w-2xl space-y-10">
				{about.sections.map((sec) => (
					<div>
						<h3 class="text-xl font-bold leading-snug">{sec.heading}</h3>
						<div class="mt-3 space-y-2">
							{sec.paragraphs.map((p) => <p class="text-lg text-ink/80">{p}</p>)}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- 11/25：原本獨立的「合作的好處」區塊，併進來做成一張玻璃卡；後面墊光暈玻璃才看得出來 -->
	<div id="benefit" class="relative mt-16">
		<div class="hf-glow hf-glow--pink -left-10 -top-10 h-64 w-64" aria-hidden="true"></div>
		<div class="hf-glow hf-glow--sky -bottom-10 -right-6 h-64 w-80" aria-hidden="true"></div>
		<div class="hf-glass p-8 sm:p-12">
			<h2 class="max-w-3xl text-2xl font-bold leading-tight sm:text-3xl">{benefit.title}</h2>
			<div class="mt-6 max-w-3xl space-y-4">
				{benefit.rows.map((r, i) => (
					<p class={`text-lg ${i === benefit.rows.length - 1 ? "font-bold text-ink" : "text-ink/80"}`}>{r.text}</p>
				))}
			</div>
		</div>
	</div>

	<Placeholder label={about.logoPlaceholder} class="mt-12 h-20" />
</Section>
