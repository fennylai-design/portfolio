---
import Section from "../ui/Section.astro";
import Placeholder from "../ui/Placeholder.astro";
import { about, benefit } from "../../content/interior";
import "../../styles/hero-flow.css";
---

<Section id="about" tone="surface">
	<!-- 11/26 區塊最上方的大字＋一行小字 -->
	<div class="mb-14 md:mb-20">
		<p class="text-4xl font-bold leading-tight tracking-tight sm:text-6xl sm:leading-tight">
			{about.bigLines.map((line) => (
				<span class="block">{line.map((c) => (c.hl ? <span class="text-brand">{c.text}</span> : c.text))}</span>
			))}
		</p>
		<p class="mt-5 max-w-3xl text-lg text-ink/70">{about.bigSub}</p>
	</div>

	<!-- 11/26 版型：左大照片，右邊大標 → 短介紹 → 底部數字列（數字列貼齊照片底部） -->
	<div class="grid gap-10 md:grid-cols-[5fr_7fr] md:gap-14">
		{about.photo ? (
			<img src={about.photo} alt={about.photoAlt} class="aspect-[4/5] w-full rounded-2xl object-cover md:aspect-auto md:h-full" />
		) : (
			<Placeholder label={about.photoPlaceholder} class="aspect-[4/5] w-full rounded-2xl" />
		)}
		<div class="flex flex-col">
			<h2 class="text-4xl font-bold leading-tight sm:text-5xl sm:leading-tight">
				{about.headlineLines.map((line) => <span class="block">{line}</span>)}
			</h2>
			<div class="mt-8 space-y-1 text-lg leading-relaxed text-ink/80">
				{about.intro.map((line) => (
					<p>{line.map((c) => (c.accent ? <span class="text-brand">{c.text}</span> : c.text))}</p>
				))}
			</div>
			<dl class="mt-12 grid grid-cols-3 gap-x-6 gap-y-8 md:mt-auto md:pt-12">
				{about.stats.map((st) => (
					<div>
						<dt class="sr-only">{st.label}</dt>
						<dd class="text-4xl font-medium leading-none text-ink sm:text-5xl">{st.num}</dd>
						<dd class="mt-3 text-base leading-snug text-ink/70">{st.label}</dd>
					</div>
				))}
			</dl>
		</div>
	</div>

	<!-- 11/25：原本獨立的「合作的好處」區塊，併進來做成一張玻璃卡；後面墊光暈玻璃才看得出來 -->
	<div id="benefit" class="relative mt-16">
		<div class="hf-glow hf-glow--pink -left-10 -top-10 h-64 w-64" aria-hidden="true"></div>
		<div class="hf-glow hf-glow--sky -bottom-10 -right-6 h-64 w-80" aria-hidden="true"></div>
		<div class="hf-glass px-6 py-10 text-center sm:px-16 sm:py-12">
			<h2 class="text-2xl font-bold leading-tight sm:text-4xl sm:leading-tight">
				{benefit.titleLines.map((line) => <span class="block lg:inline">{line}</span>)}
			</h2>
			<!-- 痛點：置中白色小卡（沿用首屏流程圖的 hf-card） -->
			<ul class="mx-auto mt-6 flex flex-wrap justify-center gap-3 lg:flex-nowrap">
				{benefit.pains.map((t) => (
					<li class="hf-card px-5 py-3 text-base text-ink/80 lg:whitespace-nowrap" style="border-radius: 999px">{t}</li>
				))}
			</ul>
			<p class="mx-auto mt-6 max-w-3xl text-xl font-bold leading-relaxed text-ink sm:text-2xl sm:leading-relaxed">
				{benefit.conclusion.map((line) => (
					<span class="sm:block">{line.map((c) => (c.hl ? <span class="text-brand">{c.text}</span> : c.text))}</span>
				))}
			</p>
		</div>
	</div>

	<Placeholder label={about.logoPlaceholder} class="mt-12 h-20" />
</Section>
