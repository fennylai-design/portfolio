---
// 下一步：11/27 改版——整區滿版品牌亮粉 #D9358D＋白色網格，不放光暈，文字全白
// 三步驟由上往下排、合併在一張白色半透明玻璃卡片裡，中間細白線分隔（亮粉底上 hf-glass 太白，改用 white/15＋白框）
// 整區約一屏高（桌機 ~780px），上 pt-24（讓開導覽列）下 pb-20
// 預約按鈕：圓角白色按鈕、粉字（粉底上用白鈕跳出來，不沿用全站直角粉鈕）
import { contact, bookingUrl } from "../../content/interior";
---

<section id="contact" class="relative snap-start overflow-hidden bg-brand pb-20 pt-24 text-white">
	<div aria-hidden="true" class="contact-grid"></div>

	<div class="relative mx-auto max-w-5xl px-6">
		<h2 class="text-center text-4xl font-bold leading-tight tracking-tight sm:text-6xl sm:leading-tight">{contact.title}</h2>

		<p class="mt-10 text-center text-2xl font-bold">{contact.stepsLabel}</p>
		<ol class="mx-auto mt-6 max-w-2xl divide-y divide-white/30 rounded-[26px] border border-white/40 bg-white/15 px-7 shadow-[inset_0_1px_0_rgb(255_255_255/0.5),0_10px_30px_-10px_rgb(34_29_33/0.25)] backdrop-blur-md sm:px-10">
			{contact.steps.map((s) => (
				<li class="py-5">
					<p class="text-xl font-bold">{s.name}</p>
					<p class="mt-2 text-lg">{s.text}</p>
				</li>
			))}
		</ol>

		<div class="mt-10 text-center">
			{contact.ctaLabel && <p class="text-sm font-semibold">{contact.ctaLabel}</p>}
			<a
				href={bookingUrl}
				class="mt-4 inline-flex h-14 items-center justify-center rounded-full bg-white px-12 text-lg font-bold text-brand shadow-[0_10px_30px_-10px_rgb(34_29_33/0.25)] transition-colors duration-200 hover:bg-pink-50 active:text-brand-deep focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand"
			>{contact.button}</a>
		</div>
	</div>
</section>

<style>
	/* 白色網格，往邊緣淡出（同 hf-grid 的做法，換成白線） */
	.contact-grid {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.12) 1px, transparent 1px);
		background-size: 48px 48px;
		background-position: center top;
		-webkit-mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 40%, transparent 100%);
		mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, #000 40%, transparent 100%);
	}
</style>
