---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import { contact, bookingUrl } from "../../content/interior";
---

<Section id="contact">
	<div class="max-w-2xl">
		<h2 class="text-3xl font-bold leading-tight">{contact.title}</h2>
		<p class="mt-6 text-lg text-ink/80">{contact.intro}</p>
		<ul class="mt-4 space-y-2">
			{contact.points.map((p) => (
				<li class="flex gap-3 text-lg text-ink/80">
					<span class="text-brand">—</span>{p}
				</li>
			))}
		</ul>
		<Button size="lg" href={bookingUrl} class="mt-10 js-contact-cta">{contact.button}</Button>
	</div>
</Section>
