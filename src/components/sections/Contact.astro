---
// 下一步：標題 → 色帶（左「下一步」、右三步驟）→ 預約按鈕
// 整區粉色底兩個深淺（11/24）：標題與預約用最淺粉 pink-50，步驟色帶用 hl-pink
// 粉底上灰字對比不夠，次要字改用 ink/80；步驟編號用深粉 brand-deep（對比 4.8）
import Button from "../ui/Button.astro";
import { contact, bookingUrl } from "../../content/interior";
---

<section id="contact" class="snap-start bg-pink-50">
	<div class="mx-auto max-w-5xl px-6 pb-16 pt-28 sm:pt-28">
		<h2 class="text-3xl font-bold leading-tight">{contact.title}</h2>
	</div>

	<div class="bg-hl-pink">
		<div class="mx-auto grid max-w-5xl gap-10 px-6 py-20 md:grid-cols-[1fr_2fr] md:gap-16">
			<p class="text-3xl font-bold leading-tight">{contact.stepsLabel}</p>
			<ol class="space-y-10">
				{contact.steps.map((s) => (
					<li>
						<p class="text-xl font-bold text-brand-deep">{s.name}</p>
						<p class="mt-3 max-w-xl text-lg text-ink/80">{s.text}</p>
					</li>
				))}
			</ol>
		</div>
	</div>

	<div class="mx-auto max-w-5xl px-6 py-20 text-center">
		<p class="text-sm font-semibold text-ink/80">{contact.ctaLabel}</p>
		<Button size="lg" href={bookingUrl} class="mt-6">{contact.button}</Button>
	</div>
</section>
