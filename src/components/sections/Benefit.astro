---
import Section from "../ui/Section.astro";
import { benefit } from "../../content/interior";
---

<Section id="benefit">
	<h2 class="max-w-3xl text-3xl font-bold leading-tight">{benefit.title}</h2>
	<ol class="mt-10 max-w-2xl space-y-4">
		{benefit.rows.map((r, i) => (
			<li>
				<p class={`text-lg ${i === benefit.rows.length - 1 ? "font-bold text-ink" : "text-ink/80"}`}>{r.text}</p>
			</li>
		))}
	</ol>
</Section>
