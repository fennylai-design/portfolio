---
import Section from "../ui/Section.astro";
import { benefit } from "../../content/interior";
---

<Section id="benefit">
	<h2 class="max-w-3xl text-3xl font-bold leading-tight">{benefit.title}</h2>
	<ol class="mt-12 divide-y divide-ink/10 border-y border-ink/10">
		{benefit.rows.map((r, i) => (
			<li class="grid gap-2 py-6 sm:grid-cols-[160px_1fr] sm:gap-6">
				<span class={`text-sm font-semibold ${i === 2 ? "text-brand" : "text-muted"}`}>{r.label}</span>
				<p class={`text-lg ${i === 2 ? "font-bold text-ink" : "text-ink/80"}`}>{r.text}</p>
			</li>
		))}
	</ol>
</Section>
