---
// STEP 03 通知膠囊（液態玻璃）
import { svg, type IconName } from "./icons";
interface Props { icon: IconName; who: string; text: string }
const { icon, who, text } = Astro.props;
---
<div class="hf-glass hf-glass--pill flex items-center gap-3 whitespace-nowrap py-2.5 pl-2.5 pr-5">
	<span class="hf-icon !h-8 !w-8 !rounded-full !bg-white/70" set:html={svg(icon, 16)} />
	<div class="leading-tight">
		<p class="hf-eyebrow" style="font-size:10px">{who}・now</p>
		<p class="text-sm font-medium">{text}</p>
	</div>
</div>
