---
import { asset } from "../lib/asset";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Fenny — 設計師大腦 × 人生實驗",
	description = "擁有設計師大腦、正在自由工作前線進行人生優化實驗的誠實記錄者。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={asset("/favicon.svg")} />
		<link rel="icon" href={asset("/favicon.ico")} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- 首屏小字型先下載（11/27 效能優化，見 global.css「首屏小字型」） -->
		<link rel="preload" href={asset("/fonts/GenSekiGothic-Bold.hero.woff2")} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={asset("/fonts/GenSekiGothic-Regular.hero.woff2")} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={asset("/fonts/GenSekiGothic-Medium.hero.woff2")} as="font" type="font/woff2" crossorigin />

		<!-- Google Fonts：只剩 Anton（合作流程數字）。Noto Serif TC 明體 11/27 拿掉（首屏大標改黑體後沒地方用，它的 CSS 會擋住首屏顯示） -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Anton：合作流程卡片的步驟數字（11/25），只載入用到的字母數字 -->
		<link href="https://fonts.googleapis.com/css2?family=Anton&text=012345&display=swap" rel="stylesheet" />

		<title>{title}</title>
	</head>
	<body class="bg-base text-ink font-sans antialiased">
		<slot />
	</body>
</html>
